# 默认：仓库内统一存 LF，检出时按平台转换
* text=auto

# Shell 脚本必须是 LF，否则 Linux / macOS 上会报 "bad interpreter: ^M"
*.sh          text eol=lf

# Windows 批处理必须是 CRLF
*.bat         text eol=crlf

# 容器 / 构建相关（LF 更安全）
Dockerfile    text eol=lf
*.dockerignore text eol=lf
nginx.conf    text eol=lf
docker-compose.yml text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

# 源码
*.java        text eol=lf
*.xml         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.css         text eol=lf
*.json        text eol=lf
*.sql         text eol=lf
*.md          text eol=lf

# 二进制
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.woff        binary
*.woff2       binary

# 语言统计时把 lock 文件排除，避免 diff 噪音
package-lock.json linguist-generated=true
